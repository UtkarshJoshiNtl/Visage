/* Visage — Tokyo Night inspired theme */

Screen {
    background: #1a1b26;
}

#dashboard {
    layout: vertical;
    overflow-y: auto;
    padding: 0 1;
}

.metric-card {
    margin: 0 0 1 0;
    background: #24283b;
    border: solid #3b4261;
    border-title-color: #7aa2f7;
    padding: 0 1;
    height: auto;
}

.metric-title {
    color: #7aa2f7;
    text-style: bold;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

.metric-bar-row {
    height: 1;
    layout: horizontal;
    margin: 0 0 0 0;
}

.metric-value {
    color: #a9b1d6;
    min-width: 8;
    padding: 0 0 0 1;
}

.metric-detail {
    color: #a9b1d6;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

ProgressBar {
    width: 1fr;
    color: #7dcfff;
    background: #1a1b26;
}

ProgressBar > .bar {
    color: #7dcfff;
}

Header {
    background: #1a1b26;
    color: #7aa2f7;
    text-style: bold;
}

Footer {
    background: #1a1b26;
    color: #565f89;
}
