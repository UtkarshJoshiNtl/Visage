/* Visage — Tokyo Night inspired theme */

Screen {
    background: #1a1b26;
}

#dashboard {
    layout: vertical;
    overflow-y: auto;
    padding: 0 1;
}

.metric-card {
    margin: 0 0 0 0;
    background: #24283b;
    border: solid #3b4261;
    border-title-color: #7aa2f7;
    padding: 0 1;
    height: auto;
}

.metric-title {
    color: #7aa2f7;
    text-style: bold;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

.metric-bar-row {
    height: 1;
    layout: horizontal;
    margin: 0 0 0 0;
}

.metric-value {
    color: #a9b1d6;
    min-width: 8;
    padding: 0 0 0 1;
}

.metric-detail {
    color: #a9b1d6;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

.metric-graph {
    color: #7dcfff;
    padding: 0 0 0 0;
    margin: 0 0 0 0;
}

ProgressBar {
    width: 1fr;
    color: #7dcfff;
    background: #1a1b26;
}

ProgressBar > .bar {
    color: #7dcfff;
}

Header {
    background: #1a1b26;
    color: #7aa2f7;
    text-style: bold;
}

Footer {
    background: #1a1b26;
    color: #565f89;
}

#proc-filter {
    display: none;
    margin: 0 0 0 0;
    padding: 0 0 0 0;
}

.inspect-modal-container {
    width: 85%;
    height: 85%;
    background: #24283b;
    border: solid #7aa2f7;
    padding: 1 2;
    align: center middle;
}

#modal-title {
    color: #7aa2f7;
    text-style: bold;
    margin-bottom: 1;
}

#modal-tabs-bar {
    height: 3;
    margin-bottom: 1;
}

#modal-tabs-bar Button {
    margin-right: 1;
    min-width: 12;
}

#modal-body-scroll {
    height: 1fr;
    background: #1a1b26;
    border: solid #3b4261;
    padding: 1;
}

#modal-footer {
    color: #565f89;
    margin-top: 1;
}
